# Скопируйте в .env и при необходимости поменяйте значения
POSTGRES_DB=credit_conveyor
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
# Порты на хосте — поменяйте, если заняты (внутри Docker сервисы общаются по своим портам)
POSTGRES_PORT=55432
WIREMOCK_PORT=8089
BACKEND_PORT=8080
FRONTEND_PORT=5173
# Ключ подписи JWT, не короче 32 байт (латиницей — 32 символа). Пусто — случайный ключ при каждом старте (токены сбрасываются)
JWT_SECRET=
# С каких адресов фронтенд обращается к API (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
